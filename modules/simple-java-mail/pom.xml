<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.simplejavamail</groupId>
        <artifactId>maven-master-project</artifactId>
        <version>9.3.9</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>simple-java-mail</artifactId>
    <packaging>jar</packaging>
    <name>Simple Java Mail</name>
    <url>https://www.simplejavamail.org/</url>
    <description>Simple API, Complex Emails. A light weight wrapper for the JavaMail SMTP API</description>

    <properties>
        <automaticModuleName>org.simplejavamail</automaticModuleName>
        <spring.version>[4.3.18.RELEASE,)</spring.version>
        <test.forkCount>8</test.forkCount>
    </properties>

    <dependencies>

        <!-- core dependencies -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>core-module</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>angus-mail-provider-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- optional support modules -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>authenticated-socks-module</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>dkim-module</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>smime-module</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
		<dependency>
			<groupId>org.simplejavamail</groupId>
			<artifactId>openpgp-module</artifactId>
			<version>${project.version}</version>
			<optional>true</optional>
		</dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>batch-module</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>outlook-module</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
			<exclusions>
				<exclusion>
					<groupId>org.eclipse.angus</groupId>
					<artifactId>angus-activation</artifactId>
				</exclusion>
			</exclusions>
        </dependency>

        <!-- testing -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>core-test-module</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mnode.ical4j</groupId>
            <artifactId>ical4j-vcard</artifactId>
            <version>2.0.0-beta2</version>
            <scope>test</scope>
        </dependency>
        <dependency><!-- SMTP test server -->
            <groupId>com.github.davidmoten</groupId>
            <artifactId>subethasmtp</artifactId>
            <version>7.2.2</version>
            <scope>test</scope>
        </dependency>
        <dependency><!-- used to test loading of Environment properties in ConfigLoaderTest -->
            <groupId>org.junit-pioneer</groupId>
            <artifactId>junit-pioneer</artifactId>
            <version>1.9.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-java9-module-info</id>
                        <configuration>
                            <!-- jsoup exposes its module descriptor from Java 11, the library's supported baseline. -->
                            <release>11</release>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>configuration-contract-library-gate</id>
                        <phase>verify</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <skip>${configuration.contract.skip}</skip>
                            <mainClass>org.simplejavamail.mailer.internal.ConfigurationContractGate</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}/.</argument>
                                <argument>run-${session.request.startTime.time}</argument>
                                <argument>library</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- Conformance CI overrides this for its two-core VM; avoid starving bounded socket fixtures during JVM startup. -->
                    <forkCount>${test.forkCount}</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>

	<profiles>
		<profile>
			<id>smtp-conformance</id>
			<properties>
				<smtp.conformance.reportsDirectory>${project.build.directory}/failsafe-reports</smtp.conformance.reportsDirectory>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.6</version>
						<configuration>
							<includes><include>**/SmtpServerConformanceIT.java</include></includes>
							<failIfNoTests>true</failIfNoTests>
							<reportsDirectory>${smtp.conformance.reportsDirectory}</reportsDirectory>
							<forkCount>1</forkCount>
							<systemPropertyVariables>
								<log4j.configurationFile>log4j2-smtp-conformance.xml</log4j.configurationFile>
							</systemPropertyVariables>
							<argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
						</configuration>
						<executions>
							<execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>modern-jdk-test-opens</id>
			<activation>
				<jdk>[9,)</jdk>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>verify-provider-neutral-consumers</id>
			<activation>
				<jdk>[11,)</jdk>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<version>3.11.0</version>
						<executions>
							<execution>
								<id>provider-neutral-runtime-path</id>
								<phase>prepare-package</phase>
								<goals><goal>build-classpath</goal></goals>
								<configuration>
									<includeArtifactIds>core-module,jakarta.mail-api,jakarta.activation-api,jmail,throwing-function,slf4j-api,jsoup</includeArtifactIds>
									<includeScope>compile</includeScope>
									<outputFile>${project.build.directory}/provider-neutral-runtime-path.txt</outputFile>
								</configuration>
							</execution>
							<execution>
								<id>dkim-provider-neutral-runtime-path</id>
								<phase>prepare-package</phase>
								<goals><goal>build-classpath</goal></goals>
								<configuration>
									<includeArtifactIds>core-module,dkim-module,utils-mail-dkim,jakarta.mail-api,jakarta.activation-api,jmail,throwing-function,slf4j-api,bcpkix-jdk18on,bcprov-jdk18on,bcutil-jdk18on,utils-data-fetcher,annotations,jsoup</includeArtifactIds>
									<includeScope>compile</includeScope>
									<outputFile>${project.build.directory}/dkim-provider-neutral-runtime-path.txt</outputFile>
								</configuration>
							</execution>
							<execution>
								<id>core-only-compile-path</id>
								<phase>prepare-package</phase>
								<goals><goal>build-classpath</goal></goals>
								<configuration>
									<includeArtifactIds>core-module,jakarta.mail-api,jakarta.activation-api,jmail,slf4j-api,annotations,spotbugs-annotations</includeArtifactIds>
									<includeScope>compile</includeScope>
									<outputFile>${project.build.directory}/core-only-compile-path.txt</outputFile>
								</configuration>
							</execution>
							<execution>
								<id>managed-angus-runtime-path</id>
								<phase>prepare-package</phase>
								<goals><goal>build-classpath</goal></goals>
								<configuration>
									<includeArtifactIds>core-module,angus-mail-provider-module,angus-mail,jakarta.mail-api,jakarta.activation-api,jmail,throwing-function,slf4j-api,jsoup</includeArtifactIds>
									<includeScope>runtime</includeScope>
									<outputFile>${project.build.directory}/managed-angus-runtime-path.txt</outputFile>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<execution>
								<id>verify-provider-neutral-consumers</id>
								<phase>verify</phase>
								<goals><goal>run</goal></goals>
								<configuration>
									<target>
										<loadfile property="providerNeutralPath" srcFile="${project.build.directory}/provider-neutral-runtime-path.txt" />
										<!-- API continuation is checked without simple-java-mail or any provider implementation on either compile path. -->
										<loadfile property="coreOnlyPath" srcFile="${project.build.directory}/core-only-compile-path.txt" />
										<mkdir dir="${project.build.directory}/core-only-classpath-classes" />
										<javac srcdir="${project.basedir}/../core-module/src/test/core-only"
											   destdir="${project.build.directory}/core-only-classpath-classes"
											   classpath="${coreOnlyPath}" excludes="module-info.java" sourcepath=""
											   release="${library.java.release}" includeantruntime="false" />
										<mkdir dir="${project.build.directory}/core-only-jpms-classes" />
										<javac srcdir="${project.basedir}/../core-module/src/test/core-only"
											   destdir="${project.build.directory}/core-only-jpms-classes"
											   modulepath="${project.basedir}/../core-module/target/classes/META-INF/versions/9${path.separator}${coreOnlyPath}"
											   release="${library.java.release}" includeantruntime="false">
											<compilerarg value="--patch-module" />
											<compilerarg value="org.simplejavamail.core=${project.basedir}/../core-module/target/core-module-${project.version}.jar" />
										</javac>
										<mkdir dir="${project.build.directory}/provider-neutral-jpms-classes" />
										<!-- JDK 11 javac treats a JAR whose descriptor lives under META-INF/versions/11 as an automatic module.
										     Point it at the descriptor directly and patch in the packaged classes. The runtime check below
										     still launches against the packaged multi-release JAR. -->
										<javac srcdir="${project.basedir}/src/test/provider-neutral-jpms"
											   destdir="${project.build.directory}/provider-neutral-jpms-classes"
											   modulepath="${project.build.directory}/classes/META-INF/versions/11${path.separator}${providerNeutralPath}"
											   release="${library.java.release}" includeantruntime="false">
											<compilerarg value="--patch-module" />
											<compilerarg value="org.simplejavamail=${project.build.directory}/${project.build.finalName}.jar" />
										</javac>
										<exec executable="${java.home}/bin/java" failonerror="true">
											<arg value="--module-path" />
											<arg path="${project.build.directory}/provider-neutral-jpms-classes${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${providerNeutralPath}" />
											<arg value="--module" />
											<arg value="org.simplejavamail.providerneutral.consumer/org.simplejavamail.providerneutral.ProviderNeutralConsumer" />
										</exec>
										<mkdir dir="${project.build.directory}/provider-neutral-classpath-classes" />
										<javac srcdir="${project.basedir}/src/test/provider-neutral-classpath"
											   destdir="${project.build.directory}/provider-neutral-classpath-classes"
											   classpath="${project.build.directory}/${project.build.finalName}.jar${path.separator}${providerNeutralPath}"
											   release="${library.java.release}" includeantruntime="false" />
										<java classname="org.simplejavamail.providerneutral.ProviderNeutralClasspathConsumer"
											  fork="true" failonerror="true"
											  classpath="${project.build.directory}/provider-neutral-classpath-classes${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${providerNeutralPath}" />
										<!-- Exercise actual DKIM module loading and signing, with a test StreamProvider and no Angus. -->
                                        <loadfile property="dkimNeutralPath" srcFile="${project.build.directory}/dkim-provider-neutral-runtime-path.txt" />
                                        <mkdir dir="${project.build.directory}/dkim-neutral-classpath" />
                                        <javac srcdir="${project.basedir}/src/test/provider-neutral-dkim"
                                               destdir="${project.build.directory}/dkim-neutral-classpath"
                                               classpath="${project.build.directory}/${project.build.finalName}.jar${path.separator}${dkimNeutralPath}"
                                               excludes="module-info.java" sourcepath="" release="${library.java.release}" includeantruntime="false" encoding="UTF-8" />
                                        <copy todir="${project.build.directory}/dkim-neutral-classpath/META-INF/services">
                                            <fileset dir="${project.basedir}/src/test/provider-neutral-dkim/META-INF/services" />
                                        </copy>
                                        <java classname="org.simplejavamail.dkimprobe.DkimConsumer" fork="true" failonerror="true"
                                              classpath="${project.build.directory}/dkim-neutral-classpath${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${dkimNeutralPath}" />
                                        <mkdir dir="${project.build.directory}/dkim-neutral-jpms" />
                                        <javac srcdir="${project.basedir}/src/test/provider-neutral-dkim"
                                               destdir="${project.build.directory}/dkim-neutral-jpms"
                                               modulepath="${project.build.directory}/classes/META-INF/versions/11${path.separator}${dkimNeutralPath}"
                                               release="${library.java.release}" includeantruntime="false" encoding="UTF-8">
                                            <compilerarg value="--patch-module" />
                                            <compilerarg value="org.simplejavamail=${project.build.directory}/${project.build.finalName}.jar" />
                                        </javac>
                                        <exec executable="${java.home}/bin/java" failonerror="true">
                                            <arg value="--module-path" />
                                            <arg path="${project.build.directory}/dkim-neutral-jpms${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${dkimNeutralPath}" />
                                            <arg value="--module" />
                                            <arg value="org.simplejavamail.dkimprobe/org.simplejavamail.dkimprobe.DkimConsumer" />
                                        </exec>

										<!-- The same external adapter JAR must work through META-INF/services and JPMS provides, without Angus. -->
										<mkdir dir="${project.build.directory}/third-party-probe-classes" />
										<javac srcdir="${project.basedir}/src/test/third-party-probe"
											   destdir="${project.build.directory}/third-party-probe-classes"
											   modulepath="${project.build.directory}/classes/META-INF/versions/11${path.separator}${providerNeutralPath}"
											   release="${library.java.release}" includeantruntime="false">
											<compilerarg value="--patch-module" />
											<compilerarg value="org.simplejavamail=${project.build.directory}/${project.build.finalName}.jar" />
										</javac>
										<jar destfile="${project.build.directory}/third-party-probe-fixture.jar"
											 basedir="${project.build.directory}/third-party-probe-classes">
											<fileset dir="${project.basedir}/src/test/third-party-probe" includes="META-INF/**" />
										</jar>
										<java classname="org.simplejavamail.thirdpartyprobe.ThirdPartyProbeConsumer"
											  fork="true" failonerror="true" timeout="30000"
											  classpath="${project.build.directory}/third-party-probe-fixture.jar${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${providerNeutralPath}">
											<arg value="classpath" />
										</java>
										<exec executable="${java.home}/bin/java" failonerror="true" timeout="30000">
											<arg value="--module-path" />
											<arg path="${project.build.directory}/third-party-probe-fixture.jar${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${providerNeutralPath}" />
											<arg value="--module" />
											<arg value="org.simplejavamail.thirdpartyprobe.fixture/org.simplejavamail.thirdpartyprobe.ThirdPartyProbeConsumer" />
											<arg value="jpms" />
										</exec>
										<loadfile property="managedAngusPath" srcFile="${project.build.directory}/managed-angus-runtime-path.txt" />
										<mkdir dir="${project.build.directory}/managed-angus-jpms-classes" />
										<javac srcdir="${project.basedir}/src/test/managed-angus-jpms"
											   destdir="${project.build.directory}/managed-angus-jpms-classes"
											   modulepath="${project.build.directory}/classes/META-INF/versions/11${path.separator}${managedAngusPath}"
											   release="${library.java.release}" includeantruntime="false">
											<compilerarg value="--patch-module" />
											<compilerarg value="org.simplejavamail=${project.build.directory}/${project.build.finalName}.jar" />
										</javac>
										<exec executable="${java.home}/bin/java" failonerror="true">
											<arg value="--module-path" />
											<arg path="${project.build.directory}/managed-angus-jpms-classes${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${managedAngusPath}" />
											<arg value="--add-modules" />
											<arg value="org.simplejavamail.mailprovider.angus" />
											<arg value="--module" />
											<arg value="org.simplejavamail.managedangus.consumer/org.simplejavamail.managedangus.ManagedAngusConsumer" />
										</exec>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
