<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.simplejavamail</groupId>
        <artifactId>maven-master-project</artifactId>
        <version>9.3.9</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cli-module</artifactId>
    <packaging>jar</packaging>
    <name>Simple Java Mail - CLI module</name>
    <url>https://www.simplejavamail.org/cli.html</url>
    <description>Simple API, Complex Emails. Now with CLI support</description>

    <properties>
        <automaticModuleName>org.simplejavamail.cli</automaticModuleName>
        <sjm.cli.metadata.force>false</sjm.cli.metadata.force>
        <maven.compiler.source>${cli.java.release}</maven.compiler.source>
        <maven.compiler.target>${cli.java.release}</maven.compiler.target>
        <maven.compiler.release>${cli.java.release}</maven.compiler.release>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>ensure-cli-metadata</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>org.simplejavamail.internal.clisupport.CliMetadataBuild</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.basedir}</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <argument>${project.basedir}/.build-cache/metadata</argument>
                                <argument>${sjm.cli.metadata.force}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-cli-metadata-jar</id>
                        <phase>verify</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>org.simplejavamail.internal.clisupport.CliMetadataPackageVerifier</mainClass>
                            <classpathScope>runtime</classpathScope>
                            <arguments>
                                <argument>jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <argument>${project.build.directory}/metadata-package-check</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration combine.self="override">
                    <release>${cli.java.release}</release>
                    <encoding>${compiler.encoding}</encoding>
                    <compilerArgument>-Xlint:all</compilerArgument>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build</id>
                        <configuration combine.self="override">
                            <rules>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                                <requireJavaVersion>
                                    <version>[${cli.java.release},)</version>
                                </requireJavaVersion>
                                <requireProperty>
                                    <property>maven.compiler.release</property>
                                    <regex>${cli.java.release}</regex>
                                </requireProperty>
                                <requireReleaseDeps>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                    <excludes>
                                        <exclude>org.eclipse.angus:angus-mail:${angus.mail.version}</exclude>
                                    </excludes>
                                </requireReleaseDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>

        <!-- core dependencies -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>simple-java-mail</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.github.bbottema</groupId>
            <artifactId>java-reflection</artifactId>
            <version>4.1.1</version>
        </dependency>

        <!-- needed for cli support -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>3.9.6</version>
        </dependency>

        <!-- read Javadoc back from the jar for use with CLI documentation -->
        <dependency><!-- Runtime library -->
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
            <version>0.15.0</version>
        </dependency>

        <!-- dependencies that should be included in the assembly for the stand-alone jar -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>open-telemetry-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>authenticated-socks-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>dkim-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>smime-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>batch-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>outlook-module</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- needed for converting the CLI options structure to binary format for quicker CLI startup -->
        <dependency>
            <groupId>com.esotericsoftware</groupId>
            <artifactId>kryo</artifactId>
            <version>5.7.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId><!-- replaces log4j-slf4j-impl: slf4j 2.x requires slf4j2 bridge -->
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>core-test-module</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency><!-- SMTP test server used by the daemon connection-reuse process test -->
            <groupId>com.github.davidmoten</groupId>
            <artifactId>subethasmtp</artifactId>
            <version>7.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>release-cli-metadata</id>
            <activation><property><name>performRelease</name><value>true</value></property></activation>
            <properties><sjm.cli.metadata.force>true</sjm.cli.metadata.force></properties>
        </profile>
        <profile>
            <id>publish-cli</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-cli-configuration</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/cli-configuration"/>
                                        <delete dir="${project.build.directory}/appassembler/lib"/>
                                        <mkdir dir="${project.build.directory}/cli-configuration"/>
                                        <copy todir="${project.build.directory}/cli-configuration">
                                            <fileset dir="${project.basedir}/src/main/resources" excludes="cli.data,therapi.data"/>
                                        </copy>
                                        <delete file="${project.build.directory}/appassembler/etc/cli.data"/>
                                        <delete file="${project.build.directory}/appassembler/etc/therapi.data"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>unpack-cli-metadata-checks</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/metadata-package-check/zip package"/>
                                        <delete dir="${project.build.directory}/metadata-package-check/tar package"/>
                                        <unzip src="${project.build.directory}/${project.build.finalName}-standalone-cli.zip"
                                               dest="${project.build.directory}/metadata-package-check/zip package"/>
                                        <untar src="${project.build.directory}/${project.build.finalName}-standalone-cli.tar"
                                               dest="${project.build.directory}/metadata-package-check/tar package"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-cli-metadata-zip</id>
                                <phase>verify</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>org.simplejavamail.internal.clisupport.CliMetadataPackageVerifier</mainClass>
                                    <classpathScope>runtime</classpathScope>
                                    <arguments>
                                        <argument>distribution</argument>
                                        <argument>${project.build.directory}/metadata-package-check/zip package</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>${project.build.directory}/metadata-package-check</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-cli-metadata-tar</id>
                                <phase>verify</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>org.simplejavamail.internal.clisupport.CliMetadataPackageVerifier</mainClass>
                                    <classpathScope>runtime</classpathScope>
                                    <arguments>
                                        <argument>distribution</argument>
                                        <argument>${project.build.directory}/metadata-package-check/tar package</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>${project.build.directory}/metadata-package-check</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>appassembler-maven-plugin</artifactId>
                        <version>2.1.0</version>
                        <configuration>
                            <configurationSourceDirectory>${project.build.directory}/cli-configuration</configurationSourceDirectory>
                            <copyConfigurationDirectory>true</copyConfigurationDirectory>
                            <repositoryLayout>flat</repositoryLayout>
                            <useTimestampInSnapshotFileName>false</useTimestampInSnapshotFileName>
                            <useWildcardClassPath>true</useWildcardClassPath>
                            <repositoryName>lib</repositoryName>
                            <showConsoleWindow>true</showConsoleWindow>
                            <platforms>
                                <platform>unix</platform>
                                <platform>windows</platform>
                            </platforms>
                            <programs>
                                <program>
                                    <mainClass>org.simplejavamail.cli.SimpleJavaMail</mainClass>
                                    <id>sjm</id>
                                </program>
                            </programs>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>assemble</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.8.0</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/standalone-cli-descriptor.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>assemble-all</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
