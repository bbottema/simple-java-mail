# Start the worker only after the isolated foundation, image publication and SMTP-secret bootstrap have completed.
terraform {
  required_version = ">= 1.15.0, < 2.0.0"
  required_providers { aws = { source = "hashicorp/aws", version = "= 6.69.1" } }
}
variable "foundation" {
  description = "Deployment output generated by this run's foundation. cloud.py supplies these resource identifiers."
  type        = map(string)
}
variable "image_digest" {
  description = "Digest of the run-owned ECR image published by cloud.py, not a mutable tag."
  type        = string
  validation {
    condition     = can(regex("^sha256:[a-f0-9]{64}$", var.image_digest))
    error_message = "Pin the built worker image by its digest."
  }
}
provider "aws" {
  region = var.foundation.Region
  default_tags { tags = { Project = "sjm-strategic-patterns", Run = var.foundation.RunName } }
}
resource "aws_ecs_task_definition" "worker" {
  family                   = var.foundation.RunName
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "256"
  memory                   = "1024"
  runtime_platform {
    cpu_architecture        = "X86_64"
    operating_system_family = "LINUX"
  }
  # ECS pulls/logs with the execution role; the Java worker accesses application data with the task role.
  execution_role_arn = var.foundation.ExecutionRole
  task_role_arn      = var.foundation.TaskRole
  container_definitions = jsonencode([{
    name = "worker", image = "${var.foundation.Repository}@${var.image_digest}", essential = true, stopTimeout = 60,
    # Only the secret ARN is passed here. The worker reads its SMTP credentials from Secrets Manager using the task role.
    environment = [for name, value in {
      AWS_REGION            = var.foundation.Region, MAIL_FROM = var.foundation.Sender,
      SMTP_HOST             = "email-smtp.${var.foundation.Region}.amazonaws.com", SMTP_SECRET_ARN = var.foundation.Secret,
      DOCUMENT_BUCKET       = var.foundation.Bucket, ATTEMPT_TABLE = var.foundation.Table,
      WORK_QUEUE_URL        = var.foundation.WorkQueue, FEEDBACK_QUEUE_URL = var.foundation.FeedbackQueue,
      SES_CONFIGURATION_SET = var.foundation.ConfigurationSet
    } : { name = name, value = value }],
    logConfiguration = { logDriver = "awslogs", options = {
      "awslogs-group" = var.foundation.LogGroup, "awslogs-region" = var.foundation.Region, "awslogs-stream-prefix" = "worker"
    } }
  }])
}
resource "aws_ecs_service" "worker" {
  name            = var.foundation.RunName
  cluster         = var.foundation.Cluster
  task_definition = aws_ecs_task_definition.worker.arn
  desired_count   = 1
  launch_type     = "FARGATE"
  network_configuration {
    subnets         = split(",", lookup(var.foundation, "Subnets", var.foundation.Subnet))
    security_groups = [var.foundation.SecurityGroup]
    # Public egress avoids a demo NAT gateway. The foundation allows no inbound traffic and the cloud worker serves no HTTP endpoint.
    # An existing subnet must already have a compatible outbound route; this template does not change borrowed networking.
    assign_public_ip = true
  }
}
output "service" { value = aws_ecs_service.worker.name }
