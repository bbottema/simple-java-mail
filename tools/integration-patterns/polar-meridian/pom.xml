<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.simplejavamail.examples</groupId>
    <artifactId>integration-patterns</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>polar-meridian</artifactId>
  <properties>
    <case.study.sources>${project.basedir}/../../../simplejavamail.org/src/assets/journal/articles</case.study.sources>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.simplejavamail.examples</groupId>
      <artifactId>application-support</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.simplejavamail</groupId>
      <artifactId>open-telemetry-module</artifactId>
      <version>${sjm.version}</version>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <version>1.54.1</version>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <version>1.54.1</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>canonical-case-study</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${case.study.sources}/polar-meridian</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>PolarMeridianApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>