compatibility_level = 3.6
myhostname = postfix.conformance.test
mydomain = conformance.test
mydestination = conformance.test
inet_interfaces = all
inet_protocols = ipv4
smtpd_peername_lookup = no
mynetworks = 127.0.0.0/8
maillog_file = /dev/stdout
syslog_name = conformance/postfix
local_recipient_maps =
local_transport = capture
default_transport = error:External delivery is disabled in this fixture
relay_transport = error:External delivery is disabled in this fixture
capture_destination_recipient_limit = 1
message_size_limit = 1048576
smtputf8_enable = yes
smtpd_tls_security_level = encrypt
smtpd_tls_cert_file = /fixture/certificate.pem
smtpd_tls_key_file = /fixture/private-key.pem
smtpd_tls_auth_only = yes
smtpd_sasl_auth_enable = yes
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_local_domain = conformance.test
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = check_recipient_access regexp:/etc/postfix/recipients, permit_sasl_authenticated, reject
smtpd_delay_reject = yes
disable_vrfy_command = yes
smtp_host_lookup = native
